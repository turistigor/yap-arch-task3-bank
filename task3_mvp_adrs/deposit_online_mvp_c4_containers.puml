@startuml deposit_online_mvp_containers

' Initial settings:

title Standard bank deposit online MVP containers

top to bottom direction

!include ../lib/C4_Container.puml


' Actors & components:

Person(new_online_client, "New online client")
Person(online_client, "Authorized online client")
Person(phone_client, "Telephone client")

Container_Boundary(bank, "Standard bank") {
    Container(site, "Website (PHP & React)", "REST API")
    Container(on_bank, "Online banking system", ".Net & MS SQL")
    Container(call_center, "Bank call center system", "REST API")
    Container(deposit_service, "Deposit service", "Java/C# & React & Oracle/MS SQL")
    Container(abs, "Auto banking system", "Delphi & Oracle")
    Container(sms_gate, "Sms gate", "REST API")

    Person(deposit_manager, "Deposit manager", "Back office")
    Person(call_center_op, "Call center operator", "Call center operator")
}

System_Ext(tele_operator, "Telecom operator", "Communication service provider")


' Relations:
Rel(new_online_client, site, "HTTPS: deposit request")
Rel(site, deposit_service, "New online client deposit req")
Rel(site, deposit_service, "Get common deposit rates")
Rel(deposit_service, deposit_manager, "New online client deposit req")
Rel(deposit_manager, deposit_service, "Save deposit rates")
Rel(deposit_manager, call_center, "Task: to call new client back")
Rel(abs, deposit_manager, "Get rates data")
Rel(call_center, call_center_op, "Task: to call new client back")
Rel(call_center_op, new_online_client, "Confirmation call with an invitation to the bank")

Rel(online_client, on_bank, "HTTPS: deposit request")
Rel(on_bank, deposit_service, "Online client deposit req")
Rel(on_bank, deposit_service, "Get personal deposit rates")
Rel(on_bank, sms_gate, "SMS operation confirmation")
Rel(deposit_manager, deposit_service, "Deposit req approvement")
Rel(deposit_service, sms_gate, "SMS deposit approved")

Rel(sms_gate, tele_operator, "SMS")
Rel(tele_operator, online_client, "SMS")

Rel(phone_client, call_center_op, "Deposit request")
Rel(call_center_op, call_center, "Phone client deposit request")
Rel(call_center, deposit_service, "Deposit request")

@enduml
